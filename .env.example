# ---- База данных (PostgreSQL) ----
# Локально (Docker): postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://kvartiry:kvartiry@localhost:5432/kvartiry?schema=public"
# Для Netlify используйте ПУЛ-строку Neon (serverless), например:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# ---- Аутентификация админки ----
# Секрет для подписи JWT-сессии (сгенерируй: openssl rand -base64 32)
AUTH_SECRET="change-me-please-generate-a-long-random-string"
# Учётка суперадмина создаётся сидом (prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

# ---- Публичные адреса ----
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_SITE_NAME="ЖК «Уникод на Технической»"

# ---- Node ----
NODE_ENV="development"
PORT="3000"
